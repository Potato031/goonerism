/* Geometry and shared states; configurable palette tokens live in buildAppStyleSheet. */
QWidget { background: transparent; color: #E0E0E2; font-size: 12px; }
QLabel { background: transparent; }
QToolTip { background: #29292C; color: #E0E0E2; border: 1px solid #55555C; padding: 7px 10px; font-size: 12px; }
QFrame#toolbar { min-height: 58px; max-height: 58px; }
QFrame#TransportBar { min-height: 48px; max-height: 48px; }
QLabel#SectionHeader { font-size: 12px; font-weight: 600; padding: 2px 0; }
QLabel#InspectorGroupLabel { font-size: 11px; font-weight: 500; padding: 8px 8px 4px; }
QLabel#LogoBold { font-weight: 600; }
QLabel#LogoLight { font-weight: 400; }
QLabel#SidebarTitle { font-size: 12px; font-weight: 500; }
QLabel#SidebarCountLabel { font-size: 11px; padding: 8px 2px 0; }
QLabel#TimecodeLabel { font-family: "DejaVu Sans Mono", "Consolas", monospace; font-size: 11px; font-weight: 400; padding: 5px 8px; }
QLabel#EmptyPreviewTitle { font-size: 20px; font-weight: 500; }
QLabel#EmptyPreviewBody { font-size: 12px; }
QLabel#MiniBadge { padding: 4px 8px; font-weight: 400; }
QLabel#StatusLabel { font-size: 12px; font-weight: 500; }
QLabel#StatusLabel[state="ok"] { color: #6FD4AC; }
QLabel#StatusLabel[state="error"] { color: #F08B85; }
QPushButton { min-height: 20px; font-weight: 500; }
QPushButton#PrimaryGhostBtn, QPushButton#ExportBtn, QDialogButtonBox QPushButton { font-size: 12px; padding: 6px 12px; }
QPushButton#ExportBtn::menu-indicator { image: none; width: 0; }
QPushButton[class="IconBtn"], QPushButton#ActionBtn { padding: 0; }
QPushButton[class="IconBtn"] { min-height: 28px; }
QPushButton#ActionBtn { min-height: 36px; max-height: 36px; min-width: 44px; max-width: 44px; }
QPushButton[class="ToolBtn"] { font-size: 12px; font-weight: 400; text-align: left; padding: 3px 8px; }
QPushButton#EmptyImportBtn { min-height: 28px; padding: 6px 20px; font-size: 12px; }
QLineEdit, QComboBox, QAbstractSpinBox, QKeySequenceEdit, QFontComboBox { padding: 5px 10px; font-size: 12px; }
QLineEdit#ExportNameInput { min-width: 100px; padding: 6px 10px; font-size: 11px; }
QLineEdit#MediaSearch { min-height: 24px; padding: 4px 10px; }
QLineEdit#CommandSearch { min-height: 32px; padding: 8px 12px; font-size: 14px; }
QComboBox::drop-down { width: 20px; border: none; background: transparent; }
QComboBox#SpeedBox { min-width: 40px; font-size: 11px; padding: 4px 8px; }
QComboBox QAbstractItemView { padding: 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { width: 18px; background: transparent; border: none; }
QMenu { padding: 6px; }
QMenu::item { padding: 8px 28px 8px 12px; font-size: 12px; font-weight: 400; }
QMenu::separator { height: 1px; margin: 5px 8px; }
QMenu::icon { padding-left: 6px; }
QTabWidget::pane { margin-top: 6px; padding: 6px; }
QTabBar::tab { padding: 8px 14px; margin: 2px; border: 1px solid transparent; font-size: 12px; }
QDialog#SettingsDialog QWidget { background: transparent; }
QListWidget#SettingsNav { outline: none; }
QListWidget#SettingsNav::item { font-size: 12px; font-weight: 500; border-radius: 4px; margin: 2px 0; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 3px; }
QSlider::groove:horizontal { height: 3px; background: rgba(255,255,255,0.14); border-radius: 1px; }
QSlider::sub-page:horizontal { border-radius: 1px; }
QSlider::handle:horizontal { background: #E0E0E2; border: 2px solid #E0E0E2; width: 8px; height: 8px; margin: -5px 0; border-radius: 5px; }
QSlider::handle:horizontal:hover { background: #FFFFFF; border-color: #FFFFFF; }
QSlider::groove:horizontal:disabled { background: rgba(255,255,255,0.07); }
QSlider::handle:horizontal:disabled { background: #55555C; border-color: #55555C; }
QSplitter::handle { background: #101011; }
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { width: 8px; background: transparent; margin: 2px; }
QScrollBar:horizontal { height: 8px; background: transparent; margin: 2px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: rgba(255,255,255,0.20); border-radius: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QListWidget#CommandList { background: transparent; border: none; outline: none; padding: 4px 0; }
QListWidget#CommandList::item { min-height: 28px; padding: 6px 12px; margin: 2px 0; border-radius: 4px; font-size: 13px; }
QWidget#ProgressNotificationBg { border-radius: 6px; }
QLabel#ProgressNotificationLabel { font-size: 12px; font-weight: 500; }
QProgressBar { text-align: center; font-size: 11px; min-height: 16px; }
QProgressBar#ProgressNotificationBar, QProgressBar#ExportProgressBar { border-radius: 4px; }
QProgressBar::chunk { border-radius: 3px; }
QWidget#ToastNotification QLabel#ToastLabel { font-size: 12px; font-weight: 500; padding: 10px 14px; }
